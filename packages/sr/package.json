{
  "name": "@recueil/sr",
  "version": "0.0.0",
  "private": true,
  "description": "Systematic review I/O: search exports into a review, PRISMA 2020, robvis and extraction tables (CONCEPT §5.10, spec/systematic-review.md).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --build tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc --build tsconfig.build.json && vitest run"
  },
  "dependencies": { "@recueil/core": "workspace:*", "@recueil/formats": "workspace:*" },
  "devDependencies": { "@types/node": "^22.20.5", "typescript": "^5.9.3", "vitest": "^4.1.12" }
}
