{
  "name": "@recueil/import-zotero",
  "version": "0.0.0",
  "private": true,
  "description": "The Zotero migrator: reads zotero.sqlite read-only, maps it onto the Recueil model, resolves and hashes every attachment, and produces the verification report the M1 exit criterion names.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --build tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc --build tsconfig.build.json && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@recueil/core": "workspace:*",
    "@recueil/formats": "workspace:*",
    "@recueil/schemas": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
