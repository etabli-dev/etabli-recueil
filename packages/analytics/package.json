{
  "name": "@recueil/analytics",
  "version": "0.0.0",
  "private": true,
  "description": "Graph and bibliometric exports: GraphML, GEXF, VOSviewer JSON, Web of Science plain text for bibliometrix, and the analytics tables (CONCEPT §5.8, ADR-0008).",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --build tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc --build tsconfig.build.json && vitest run"
  },
  "dependencies": { "@recueil/core": "workspace:*", "drizzle-orm": "^0.45.4" },
  "devDependencies": { "@types/node": "^22.20.5", "typescript": "^5.9.3", "vitest": "^4.1.12" }
}
