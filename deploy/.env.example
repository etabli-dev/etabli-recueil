# Recueil — deployment configuration
#
# Copy to `.env` beside the compose files and edit. `.env` is git-ignored; this file is not, so
# never put a real credential here.
#
#   cp deploy/.env.example deploy/.env
#
# Every variable below has a working default, either here or in the image, so an empty `.env` starts
# a usable single-user server with a SQLite database and local file storage. Uncomment only what you
# are changing.
#
# Phase 0 caveat: the server does not exist yet. This file is the intended configuration contract
# rather than an observed one, and where the two disagree once code lands, this file is the thing
# that is wrong.
#
# Secrets: values here are visible to anything that can read the file and appear in
# `docker inspect`. For a deployment that cares, use Docker or Podman secrets and the
# `${file:/run/secrets/name}` reference form described in spec/plugin-api.md §4.3 instead.


# =================================================================================================
# Compose — how the container is run. Read by docker compose, not by the server.
# =================================================================================================

# The published image and the tag to run. Pin a version in anything you rely on; `latest` moves.
RECUEIL_IMAGE=ghcr.io/etabli-dev/recueil
RECUEIL_VERSION=latest

# Where the port is published on the host. The default binds to loopback only, on the assumption
# that a reverse proxy terminates TLS in front of it (CONCEPT.md §5.15). Set 0.0.0.0 to expose the
# server on the LAN, and understand that v1 has single-user token auth and no rate limiting before
# you do.
RECUEIL_PUBLISH_ADDR=127.0.0.1
RECUEIL_PUBLISH_PORT=3000

# Container timezone. Affects log timestamps and the date heuristics on scanned office documents.
TZ=Europe/Berlin


# =================================================================================================
# Server — the core settings
# =================================================================================================

# Listen address and port inside the container. Leave RECUEIL_HOST at 0.0.0.0: loopback inside a
# container is not reachable from outside it. Change RECUEIL_PUBLISH_ADDR above instead.
RECUEIL_HOST=0.0.0.0
RECUEIL_PORT=3000

# The database. SQLite is the only supported backend in v1 (ADR-0015); the URL scheme selects the
# driver (ADR-0003), so a future Postgres deployment sets
# RECUEIL_DATABASE_URL=postgres://recueil:secret@postgres:5432/recueil here and nothing else.
RECUEIL_DATABASE_URL=file:/data/recueil.sqlite

# The content-addressed file store: every ingested Document, laid out by SHA-256 so the tree is
# readable without the application (P2, P10). Must be on the /data volume, or on a mount of its own.
RECUEIL_STORAGE_PATH=/data/storage

# Scratch space for archive extraction (zip, eml). Cleaned after hashing; sized for the largest
# archive you expect to import, not for the library.
RECUEIL_SCRATCH_PATH=/data/scratch

# trace | debug | info | warn | error | fatal. Structured JSON on stdout; the container runtime is
# the log store.
RECUEIL_LOG_LEVEL=info

# The externally reachable URL, used for links in webhooks, exported `.bib` endpoints and the
# connector. Set this to the public URL when the server sits behind a reverse proxy.
RECUEIL_BASE_URL=http://localhost:3000

# Trust X-Forwarded-* headers. Turn this on only when a proxy you control sets them, because it
# changes what the audit log records as the client address.
RECUEIL_TRUST_PROXY=false

# Bootstrap API token. If set, the server ensures a full-scope token with this value exists at boot,
# which is how an unattended deployment gets a credential without an interactive step. If unset, use
# `docker compose exec recueil recueil token create` after first start. Generate one with
# `openssl rand -hex 32`.
#RECUEIL_BOOTSTRAP_TOKEN=

# Job runner concurrency (ADR-0010). The queue lives in the database and runs in the server process,
# so this is the ceiling on parallel enrichment, OCR and graph expansion. Conservative by default:
# the resolvers are rate-limited upstream and a bigger number mostly buys 429s.
RECUEIL_JOB_CONCURRENCY=2
RECUEIL_INGEST_CONCURRENCY=2

# Extra directories to load plugins from, colon-separated (spec/plugin-api.md §3). Development route;
# leave unset in a normal deployment.
#RECUEIL_PLUGIN_PATH=/data/plugins

# Development mode: watch-mode plugin reload and verbose errors. Never set this in a deployment that
# is reachable by anyone else.
#RECUEIL_DEV=0


# =================================================================================================
# Search
# =================================================================================================

# fts5 | meilisearch. FTS5 is built into SQLite and needs no sidecar; Meilisearch is worth it for
# large libraries and for typo tolerance (ADR-0011). Switching backends re-indexes.
RECUEIL_SEARCH_BACKEND=fts5

# Only read when RECUEIL_SEARCH_BACKEND=meilisearch. The URL is the compose service name when the
# `search` profile in docker-compose.sidecars.yml is active.
#RECUEIL_MEILISEARCH_URL=http://meilisearch:7700
#RECUEIL_MEILISEARCH_KEY=

# Meilisearch's own master key, read by the sidecar container. Must match RECUEIL_MEILISEARCH_KEY.
# Generate with `openssl rand -hex 32`; Meilisearch refuses to start in production without one.
#MEILI_MASTER_KEY=


# =================================================================================================
# Optional sidecars (docker-compose.sidecars.yml). Each is empty by default, and an empty value
# means the feature is off rather than broken: ingestion degrades to what it can do without it.
# =================================================================================================

# GROBID: metadata, reference lists and in-text citation contexts from scholarly PDFs
# (CONCEPT.md §5.3 stage 6, §5.8). Profile `grobid`.
#RECUEIL_GROBID_URL=http://grobid:8070

# zotero/translation-server: URL, DOI, PMID, ISBN and arXiv imports, and the ~600 Zotero translators
# (ADR-0006). Profile `translation`.
#RECUEIL_TRANSLATION_SERVER_URL=http://translation-server:1969

# OCR (CONCEPT.md §5.3 stage 5). Only pages with no text layer are OCRed. The language list is
# Tesseract's `+`-separated form and every language named must have a pack installed in the image
# doing the work.
RECUEIL_OCR_ENABLED=true
RECUEIL_OCR_LANGUAGES=eng+deu


# =================================================================================================
# Enrichment credentials (CONCEPT.md §5.4)
#
# All of these are optional: every resolver works without a key, more slowly and with a lower rate
# limit. Supplying a contact address is not a credential but a courtesy — it is what puts a request
# in Crossref's and OpenAlex's polite pool, which is faster and less likely to be throttled than
# anonymous access.
#
# The resolvers are first-party plugins, so a plugin's settings reference these by name rather than
# holding a copy: `${env:OPENALEX_API_KEY}` in the plugin's settings resolves at read time and is
# never written to the database (spec/plugin-api.md §4.3). The alternative form, overriding a
# setting wholesale from the environment, is `RECUEIL_PLUGIN_<NAME>__<PATH>` — for example
# RECUEIL_PLUGIN_RECUEIL_RESOLVER_OPENALEX__MAILTO.
# =================================================================================================

# Crossref — DOI metadata, reference lists, retraction and correction relations. The mailto goes in
# the polite pool; the Plus token is a paid subscription and is not needed for normal use.
#CROSSREF_MAILTO=you@example.org
#CROSSREF_PLUS_TOKEN=

# OpenAlex — works, authors, venues, topics, citation edges and metrics. CC0 and open; the mailto is
# the polite pool, the key only matters at scale.
#OPENALEX_MAILTO=you@example.org
#OPENALEX_API_KEY=

# PubMed / NCBI E-utilities — PMID, PMCID, MeSH, abstracts. Without a key the limit is 3 requests a
# second; with one, 10. Tool and email are what NCBI asks every client to identify itself with.
#NCBI_API_KEY=
#NCBI_TOOL=recueil
#NCBI_EMAIL=you@example.org

# Semantic Scholar — citations, citation intents, influential citations, TLDRs. The public endpoint
# is heavily throttled; a free key is worth requesting if S2 is used for anything bulk.
#SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall — open-access copies of paywalled DOIs, used by the oa_status check (CONCEPT.md §5.5)
# and by full-text retrieval in the systematic-review module (§5.10). The API is free and requires
# no key, but every request must carry a contact address, so Unpaywall is off until this is set.
#UNPAYWALL_EMAIL=you@example.org

# ORCID — author identity and disambiguation. Public records need no credentials; a registered
# client is only needed for the member API.
#ORCID_CLIENT_ID=
#ORCID_CLIENT_SECRET=

# Google Books — ISBN lookup. OpenLibrary is tried first and needs nothing; this is the fallback and
# works without a key at a lower quota.
#GOOGLE_BOOKS_API_KEY=

# DataCite (datasets, software), arXiv (preprints) and OpenLibrary (ISBN) need no credentials at all
# and so have no variables here.
