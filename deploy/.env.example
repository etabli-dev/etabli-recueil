# Copy beside docker-compose.yml as .env. Never commit real credentials.
# The default builds a local development image and exposes only host loopback.
RECUEIL_IMAGE=recueil
RECUEIL_IMAGE_TAG=local
RECUEIL_PUBLISH_ADDR=127.0.0.1
RECUEIL_PUBLISH_PORT=3000
TZ=Europe/Berlin

# Current server settings; apps/server/src/config.ts is authoritative.
RECUEIL_HOST=0.0.0.0
RECUEIL_PORT=3000
RECUEIL_DATABASE_URL=file:/data/recueil.sqlite
RECUEIL_STORAGE_PATH=/data/storage
RECUEIL_LOG_LEVEL=info
RECUEIL_MODE=server
RECUEIL_BASE_URL=http://localhost:3000
RECUEIL_TRUST_PROXY=false
RECUEIL_SHUTDOWN_TIMEOUT_MS=10000

# Initially local only. Create a token through POST /api/v1/tokens, save its secret,
# then set true and recreate the service before allowing any remote access.
RECUEIL_REQUIRE_AUTH=false
# Browser origins, comma-separated. Leave unset unless a separate UI needs them.
#RECUEIL_CORS_ORIGIN=http://localhost:5173

# Required only to store credentials for remote ingestion/storage backends.
# Generate and privately back up a 32-byte key (64 hex characters or base64).
# This is an actual value, not a ${file:...} reference: that syntax is not implemented.
# .env and container environment are readable by the host/container administrator.
#RECUEIL_SECRET_KEY=

# Folder sources can read only directories mounted into the container.
# Restrict the allow-list to deliberate input mounts; do not expose a home directory.
#RECUEIL_INGEST_ALLOWED_ROOTS=/imports
RECUEIL_INGEST_SCRATCH_PATH=/data/scratch
RECUEIL_INGEST_CONFIDENCE_THRESHOLD=0.75
RECUEIL_MAX_UPLOAD_BYTES=536870912

# Base image has no OCR executable. Optional OCR adapters are not a separate worker.
RECUEIL_OCR_ENGINE=none
#RECUEIL_OCR_BINARY=/usr/bin/ocrmypdf
#RECUEIL_OCR_LANGUAGES=eng,deu
