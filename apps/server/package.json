{
  "name": "@recueil/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Recueil server: the Fastify application that serves the REST contract, the health endpoint and the generated OpenAPI document.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "recueil-server": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --build tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsc --build tsconfig.build.json && vitest run",
    "test:watch": "vitest",
    "openapi": "pnpm run build && node dist/bin/write-openapi.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/sensible": "^6.0.3",
    "@recueil/core": "workspace:*",
    "@recueil/formats": "workspace:*",
    "@recueil/ingest": "workspace:*",
    "@recueil/ingest-sources": "workspace:*",
    "@recueil/rules": "workspace:*",
    "@recueil/schemas": "workspace:*",
    "@recueil/storage-backends": "workspace:*",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "pino": "^9.13.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
