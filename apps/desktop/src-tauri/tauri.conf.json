{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recueil",
  "version": "0.1.0",
  "identifier": "com.raban.etabli.recueil",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm --filter \"@recueil/desktop...\" run build",
    "beforeDevCommand": {
      "script": "pnpm --filter \"@recueil/desktop...\" run build",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: http://127.0.0.1:* http://localhost:* http://[::1]:* https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://[::1]:* https:",
        "worker-src": "'self' blob:",
        "object-src": "http://127.0.0.1:* http://localhost:* http://[::1]:* https:",
        "frame-src": "http://127.0.0.1:* http://localhost:* http://[::1]:* https:",
        "media-src": "'self'",
        "manifest-src": "'self'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Self-hosted document and reference manager",
    "longDescription": "Recueil gathers documents from anywhere, keeps a content-addressed library with a bibliographic facet, verifies references and exposes the library to R, Python and LLMs. This desktop application is a client of a Recueil server.",
    "publisher": "R. Heller",
    "copyright": "Copyright 2026 R. Heller",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://github.com/etabli-dev/etabli-recueil",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "section": "science",
        "desktopTemplate": "linux/recueil.desktop",
        "files": {
          "/usr/share/doc/etabli-recueil/copyright": "linux/copyright",
          "/usr/share/doc/etabli-recueil/LICENSE": "../../../LICENSE"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
