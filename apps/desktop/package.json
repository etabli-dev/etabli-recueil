{
  "name": "@recueil/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Recueil desktop shell: the web client in a Tauri 2 window for Linux, Windows and macOS, connected to a Recueil server.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/assemble.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "package": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@recueil/web": "workspace:*",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.4",
    "vitest": "^5.1.0"
  }
}
