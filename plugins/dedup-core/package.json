{
  "name": "@recueil/plugin-dedup-core",
  "version": "1.0.0",
  "private": true,
  "description": "First-party record deduplication rules: identifier match and fuzzy title/year/author match (CONCEPT §5.6).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json",
    "./recueil.plugin.json": "./recueil.plugin.json"
  },
  "files": ["dist", "recueil.plugin.json", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --build tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc --build tsconfig.build.json && vitest run"
  },
  "dependencies": { "@recueil/plugin-sdk": "workspace:*" },
  "devDependencies": { "@types/node": "^22.20.5", "typescript": "^5.9.3", "vitest": "^5.1.1" }
}
