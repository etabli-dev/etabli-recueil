{
  "name": "recueil",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Recueil \u2014 self-hosted, API-first document and reference manager. Monorepo root; the packages are in apps/, packages/ and plugins/.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint apps packages scripts --max-warnings 0",
    "smoke": "node scripts/smoke-health.mjs",
    "check:spec": "node scripts/validate-spec.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "globals": "^16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "yaml": "^2.9.1"
  }
}
