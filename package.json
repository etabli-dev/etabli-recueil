{
  "name": "recueil",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Recueil — self-hosted, API-first document and reference manager. Monorepo root; the packages are in apps/, packages/ and plugins/.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "smoke": "node scripts/smoke-health.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
