% Recueil fixture — @string macros defined in a file of their own.
% This is how a lab shares journal abbreviations: one macro file, concatenated ahead of the
% bibliography at build time. On its own it has 0 entries and 6 macros; concatenated with
% `uses-macros.bib` it resolves every one of that file's four entries.
%
% An importer handed this file alone must not report an error and must not report an entry.

@string{aqua = {Aquatic Sciences}}
@string{ees  = {Environmental Earth Sciences}}
@string{hp   = {Hydrological Processes}}
@string{jawr = {Journal of the American Water Resources Association}}
@string{sotc = {Science of the Total Environment}}
@string{wrm  = {Water Resources Management}}
